PORT=5000
# Local MongoDB example:
MONGODB_URI=mongodb://localhost:27017/attendance_system
USE_MEMORY_DB=false
# For in-memory demo without MongoDB installed:
# MONGODB_URI=memory
# USE_MEMORY_DB=true
# AUTO_SEED=true seeds demo users on every start (also auto when USE_MEMORY_DB=true)
AUTO_SEED=false
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development
